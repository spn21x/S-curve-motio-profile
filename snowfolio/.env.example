# Snowfolio configuration
#
# Leave these UNSET for local development — the app stores transactions in
# data/transactions.json automatically.
#
# Set BOTH to use Supabase (Postgres) instead — required for serverless
# hosting like Vercel, where the filesystem is ephemeral.
# Use the SERVICE ROLE key (server-side only — never expose to the browser).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
